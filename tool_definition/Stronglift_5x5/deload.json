        },
        "minWeightChangeInKg": {
          "type": "number",
          "description": "要增加的重量，通常是 2.5 kg。"
        },
        "deloadPercentage": {
          "type": "number",
          "description": "降低重量的比率。"
        }
      },
      "required": [
        "currentWeightKg",
        "minWeightChangeInKg",
        "deloadPercentage"
      ]
    }
  }
}