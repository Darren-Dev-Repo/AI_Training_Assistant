{
  "type": "function",
  "function": {
    "name": "deload",
    "description": "使用者未完成預計重量，挑戰失敗時，使用此工具計算下一次的訓練重量。",
    "parameters": {
      "type": "object",
      "properties": {
        "currentWeightKg": {
          "type": "number",
